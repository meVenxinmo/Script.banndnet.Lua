visualsTab:CreateSection("Ultimate Camera & Visuals")
local CamHeadlockActive = false
visualsTab:CreateToggle({
Name = "Sky Strong Kill",
Default = false,
Callback = function(state)
CamHeadlockActive = state
end
})
local camAngleX = 0
local camAngleY = 0
local isDragging = false
local lastMousePos = Vector2.new()
local cInputB = UserInputService.InputBegan:Connect(function(input, gpe)
if gpe then return end
if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
isDragging = true
lastMousePos = UserInputService:GetMouseLocation()
end
end)
table.insert(connections, cInputB)
local cInputE = UserInputService.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
isDragging = false
end
end)
table.insert(connections, cInputE)
local cInputC = UserInputService.InputChanged:Connect(function(input)
if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
local currentPos = UserInputService:GetMouseLocation()
local delta = currentPos - lastMousePos
lastMousePos = currentPos
camAngleX = camAngleX - delta.X * 0.005
camAngleY = math.clamp(camAngleY - delta.Y * 0.005, -math.rad(45), math.rad(45))
end
end)
table.insert(connections, cInputC)
local cCamHeadlock = RunService.RenderStepped:Connect(function()
if CamHeadlockActive then
local targetHead = nil
local minDist = math.huge
for _, p in ipairs(Players:GetPlayers()) do
if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
local hum = p.Character:FindFirstChildOfClass("Humanoid")
if hum and hum.Health > 0 then
local dist = (Camera.CFrame.Position - p.Character.Head.Position).Magnitude
if dist < minDist then
minDist = dist
targetHead = p.Character.Head
end
end
end
end
if targetHead then
local headPos = targetHead.Position
local maxDistance = 15
local rotatedCFrame = CFrame.new(headPos) * CFrame.Angles(0, camAngleX, 0) * CFrame.Angles(camAngleY, 0, 0)
local desiredCamPos = rotatedCFrame * Vector3.new(0, 2, maxDistance)
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
local filterList = {LocalPlayer.Character}
for _, p in ipairs(Players:GetPlayers()) do
if p.Character then table.insert(filterList, p.Character) end
end
raycastParams.FilterDescendantsInstances = filterList
local rayResult = workspace:Raycast(headPos, desiredCamPos - headPos, raycastParams)
local finalCamPos = desiredCamPos
if rayResult then
finalCamPos = rayResult.Position - (desiredCamPos - headPos).Unit * 0.5
end
Camera.CFrame = CFrame.new(finalCamPos, headPos)
end
end
end)
table.insert(connections, cCamHeadlock)
local TracerEnabled = false
local FovSquareEnabled = false
local FovSmartAimEnabled = false
local AimPower = 20
local FovRadius = 50
stanza = true
visualsTab:CreateToggle({
Name = "Tracer & Square ESP",
Default = false,
Callback = function(state)
TracerEnabled = state
end
})
visualsTab:CreateToggle({
Name = "Toggle FOV Square",
Default = false,
Callback = function(state)
FovSquareEnabled = state
end
})
visualsTab:CreateToggle({
Name = "FOV Smart Silent Aim",
Default = false,
Callback = function(state)
FovSmartAimEnabled = state
end
})
visualsTab:CreateSlider({
Name = "Aim Smoothness",
Min = 1,
Max = 100,
Increment = 1,
Default = 20,
Suffix = "",
Callback = function(value)
AimPower = value
end
})
local tracers = {}
local function removeTracer(player)
if tracers[player] then
for _, obj in pairs(tracers[player]) do
pcall(function() obj:Remove() end)
end
tracers[player] = nil
end
end
local cRem = Players.PlayerRemoving:Connect(function(player)
removeTracer(player)
end)
table.insert(connections, cRem)
local cTrace = RunService.RenderStepped:Connect(function()
local activePlayers = {}
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer then
activePlayers[player] = true
if not tracers[player] then
tracers[player] = {
Line = Drawing.new("Line"),
Square = Drawing.new("Square"),
Text = Drawing.new("Text"),
HealthBarBG = Drawing.new("Line"),
HealthBar = Drawing.new("Line"),
HealthText = Drawing.new("Text")
}
tracers[player].Line.Thickness = 1.5
tracers[player].Line.Color = Color3.fromRGB(255, 255, 255)
tracers[player].Square.Size = Vector2.new(22, 22)
tracers[player].Square.Thickness = 1.5
tracers[player].Square.Filled = false
tracers[player].Square.Color = Color3.fromRGB(255, 255, 255)
tracers[player].Text.Size = 13
tracers[player].Text.Center = true
tracers[player].Text.Color = Color3.fromRGB(255, 255, 255)
tracers[player].HealthBarBG.Thickness = 5
tracers[player].HealthBarBG.Color = Color3.fromRGB(50, 50, 50)
tracers[player].HealthBar.Thickness = 4
tracers[player].HealthBar.Color = Color3.fromRGB(255, 220, 0)
tracers[player].HealthText.Size = 10
tracers[player].HealthText.Color = Color3.fromRGB(255, 220, 0)
tracers[player].HealthText.Center = true
end
local line = tracers[player].Line
local square = tracers[player].Square
local text = tracers[player].Text
local hbBG = tracers[player].HealthBarBG
local hb = tracers[player].HealthBar
local ht = tracers[player].HealthText
local char = player.Character
local head = char and char:FindFirstChild("Head")
local humanoid = char and char:FindFirstChildOfClass("Humanoid")
if TracerEnabled and char and head and humanoid and humanoid.Health > 0 then
local vector, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.8, 0))
if onScreen then
line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
line.To = Vector2.new(vector.X, vector.Y)
line.Visible = true
square.Position = Vector2.new(vector.X - 11, vector.Y - 11)
square.Visible = FovSquareEnabled
local hrp = char:FindFirstChild("HumanoidRootPart")
local distance = hrp and math.floor((hrp.Position - Camera.CFrame.Position).Magnitude) or 0
text.Text = player.Name .. " [" .. distance .. "m]"
text.Position = Vector2.new(vector.X, vector.Y - 32)
text.Visible = true
local barWidth = 38
local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
local barX = vector.X - (barWidth / 2)
local barY = vector.Y - 12
hbBG.From = Vector2.new(barX, barY)
hbBG.To = Vector2.new(barX + barWidth, barY)
hbBG.Visible = true
hb.From = Vector2.new(barX, barY)
hb.To = Vector2.new(barX + (barWidth * healthPercent), barY)
hb.Visible = true
ht.Text = math.floor(humanoid.Health) .. " HP"
ht.Position = Vector2.new(vector.X, barY + 6)
ht.Visible = true
else
line.Visible = false
square.Visible = false
text.Visible = false
hbBG.Visible = false
hb.Visible = false
ht.Visible = false
end
else
line.Visible = false
square.Visible = false
text.Visible = false
hbBG.Visible = false
hb.Visible = false
ht.Visible = false
end
end
end
for player, _ in pairs(tracers) do
if not activePlayers[player] then
removeTracer(player)
end
end
end)
table.insert(connections, cTrace)
local function isVisible(targetPart)
local origin = Camera.CFrame.Position
local direction = (targetPart.Position - origin)
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
local filterList = {LocalPlayer.Character}
for _, p in ipairs(Players:GetPlayers()) do
if p.Character then table.insert(filterList, p.Character) end
end
raycastParams.FilterDescendantsInstances = filterList
local result = workspace:Raycast(origin, direction, raycastParams)
if result then return false end
return true
end
local cAim = RunService.RenderStepped:Connect(function()
if not FovSmartAimEnabled then return end
local target = nil
local shortestDistance = math.huge
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer and player.Character then
local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
local head = player.Character:FindFirstChild("Head")
if humanoid and humanoid.Health > 0 and head then
if isVisible(head) then
local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
if onScreen then
local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
if distance < FovRadius and distance < shortestDistance then
shortestDistance = distance
target = head
end
end
end
end
end
end
if target then
local cameraCFrame = Camera.CFrame
local targetPos = target.Position
local direction = (targetPos - cameraCFrame.Position).Unit
local lookAtCFrame = CFrame.new(cameraCFrame.Position, cameraCFrame.Position + direction)
local alpha = math.clamp(AimPower / 100, 0.05, 1)
Camera.CFrame = cameraCFrame:Lerp(lookAtCFrame, alpha)
end
end)
table.insert(connections, cAim)
serverTab:CreateSection("Server Utility")
serverTab:CreateButton({
Name = "Copy Server JobId",
Callback = function()
if setclipboard then setclipboard(game.JobId) end
end
})
serverTab:CreateButton({
Name = "Auto Join Most Populated Server",
Callback = function()
task.spawn(function()
local HttpService = game:GetService("HttpService")
local servers = {}
local cursor = ""
repeat
local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
local success, response = pcall(function()
return HttpService:JSONDecode(game:HttpGet(url))
end)
if success and response and response.data then
for _, s in ipairs(response.data) do
if type(s) == "table" and s.playing and s.maxPlayers and s.id then
if s.playing < s.maxPlayers then
table.insert(servers, s)
end
end
end
cursor = response.nextPageCursor
else
break
end
until not cursor or #servers > 50
if #servers > 0 then
table.sort(servers, function(a, b)
return a.playing > b.playing
end)
local targetServer = servers[1]
task.wait(1)
TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer.id, LocalPlayer)
end
end)
end
})
local targetJobId = ""
serverTab:CreateTextBox({
Name = "Server JobId Input",
PlaceholderText = "Paste JobId here...",
Callback = function(value)
targetJobId = value
end
})
serverTab:CreateButton({
Name = "Join Server by JobId",
Callback = function()
if targetJobId ~= "" then
pcall(function()
TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
end)
end
end
})
