]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
if setfpscap then setfpscap(60) end
local Graphite = loadstring(game:HttpGet("https://raw.githubusercontent.com/meVenxinmo/GraphiteUI/master/GraphiteUI.lua"))()
local Window = Graphite:CreateWindow({
Name = "Reload Native Menu",
Size = Vector2.new(480, 380),
ToggleKey = Enum.KeyCode.RightShift
})
local connections = {}
local combatTab = Window:CreateTab("Combat", "rbxassetid://6023426915")
local visualsTab = Window:CreateTab("Visuals", "rbxassetid://6023426915")
local serverTab = Window:CreateTab("Server", "rbxassetid://6023426915")
Window:CreateSettingsTab("Settings", "rbxassetid://6023426915")
combatTab:CreateSection("Combat Features")
local FastFireEnabled = false
combatTab:CreateToggle({
Name = "Extreme Rapid Fire",
Default = false,
Callback = function(state)
FastFireEnabled = state
if FastFireEnabled then
task.spawn(function()
while FastFireEnabled do
pcall(function()
local character = LocalPlayer.Character
if character then
for _, tool in ipairs(character:GetChildren()) do
if tool:IsA("Tool") then
for _, desc in ipairs(tool:GetDescendants()) do
if desc.Name == "FireRate" and (desc.IsA(desc, "NumberValue") or desc.IsA(desc, "IntValue")) then
desc.Value = 0.02
end
end
end
end
local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
if backpack then
for _, tool in ipairs(backpack:GetChildren()) do
if tool:IsA("Tool") then
for _, desc in ipairs(tool:GetDescendants()) do
if desc.Name == "FireRate" and (desc.IsA(desc, "NumberValue") or desc.IsA(desc, "IntValue")) then
desc.Value = 0.02
end
end
end
end
end
end
end)
task.wait(0.01)
end
end)
end
end
})
local _G_HeadSize = 5
local _G_HitboxActive = false
combatTab:CreateSlider({
Name = "Hitbox Size",
Min = 1,
Max = 200,
Increment = 1,
Default = 5,
Suffix = " studs",
Callback = function(value)
_G_HeadSize = value
end
})
combatTab:CreateToggle({
Name = "Enable Hitbox",
Default = false,
Callback = function(state)
_G_HitboxActive = state
end
})
local playersList = {}
task.spawn(function()
local function updatePlayers()
playersList = {}
for _, v in ipairs(Players:GetPlayers()) do
if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
table.insert(playersList, v)
end
end
end
local cHit = RunService.RenderStepped:Connect(function()
if _G_HitboxActive then
for _, p in ipairs(playersList) do
if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
local hrp = p.Character.HumanoidRootPart
hrp.Size = Vector3.new(_G_HeadSize, _G_HeadSize, _G_HeadSize)
hrp.Transparency = 0.7
hrp.Color = Color3.fromRGB(88, 88, 135)
hrp.Material = Enum.Material.Neon
hrp.CanCollide = false
end
end
else
for _, p in ipairs(playersList) do
if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
local hrp = p.Character.HumanoidRootPart
if hrp.Size ~= Vector3.new(2, 2, 1) then
hrp.Size = Vector3.new(2, 2, 1)
hrp.Transparency = 1
hrp.CanCollide = true
end
end
end
end
end)
table.insert(connections, cHit)
while task.wait(1) do
updatePlayers()
end
end)
local infiniteJumpEnabled = false
combatTab:CreateToggle({
Name = "Infinite Jump",
Default = false,
Callback = function(state)
infiniteJumpEnabled = state
end
})
local cInfJump = UserInputService.JumpRequest:Connect(function()
if infiniteJumpEnabled then
local char = LocalPlayer.Character
local hum = char and char:FindFirstChildOfClass("Humanoid")
if hum then
hum:ChangeState(Enum.HumanoidStateType.Jumping)
end
end
end)
